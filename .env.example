# ---------------- Forex (escolha um) ----------------
# OANDA (recomendado): conta DEMO grátis, sem limite prático de consultas.
#   1. Crie a conta demo em https://www.oanda.com  ("Try a free demo" / conta de prática)
#   2. No painel da conta: Manage API Access  →  Generate  (gera o token pessoal)
#   3. Cole o token abaixo (sem aspas) e renomeie este arquivo para .env
OANDA_TOKEN=

# Twelve Data: plano grátis (800 consultas/dia). Serve para histórico; ao vivo aguenta ~1 par.
TWELVEDATA_API_KEY=

# ---------------- Alertas no Telegram (opcional) ----------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
